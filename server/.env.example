# DealPilot AI — Backend Environment Configuration
# Project: DealPilot | Cluster: DealPilotCluster | Database: dealpilot

# MongoDB Atlas Connection String
# Format: mongodb+srv://<username>:<password>@<cluster>/dealpilot?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/dealpilot?retryWrites=true&w=majority

# JWT Authentication Secret (use a strong random secret)
JWT_SECRET=replace_with_a_secure_random_secret

# Server Port & Client URL
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Optional AI & Payment API Keys
RAZORPAY_KEY_ID=rzp_test_dealpilot_mock
RAZORPAY_KEY_SECRET=test_secret_dealpilot_mock
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
